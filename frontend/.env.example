# =============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# For production, copy to .env.production

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL
# Development: http://localhost:8000
# Production: https://api.perenniaai.com
# Vite production: VITE_API_URL=https://api.perenniaai.com
REACT_APP_API_URL=http://localhost:8000

# WebSocket URL for real-time features
# Development: ws://localhost:8000
# Production: wss://api.perenniaai.com
# Vite production: VITE_WS_URL=wss://api.perenniaai.com
REACT_APP_WS_URL=ws://localhost:8000

# App URL (frontend)
# Vite production: VITE_APP_URL=https://app.perenniaai.com

# =============================================================================
# MICROSOFT AUTHENTICATION (Required for LO login)
# =============================================================================
# Azure AD App Registration Client ID
# Register at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
REACT_APP_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# =============================================================================
# GOOGLE PLACES API (Required for address autocomplete)
# =============================================================================
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API, Geocoding API
REACT_APP_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =============================================================================
# SOCIAL LOGIN (Optional - for borrower authentication)
# =============================================================================
# Google OAuth
# Configure at: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id

# Facebook Login
# Configure at: https://developers.facebook.com/apps
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id

# LinkedIn Login
# Configure at: https://www.linkedin.com/developers/apps
REACT_APP_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Apple Sign In
# Configure at: https://developer.apple.com/account/resources/identifiers
REACT_APP_APPLE_CLIENT_ID=your-apple-client-id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features in development
REACT_APP_ENABLE_AGENT_DASHBOARD=true
REACT_APP_ENABLE_AGENT_GYM=true
REACT_APP_ENABLE_PURL_PORTAL=true
REACT_APP_ENABLE_VIDEO_FEATURE=true

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
# Sentry for error tracking
# Get DSN from: https://sentry.io
REACT_APP_SENTRY_DSN=

# Google Analytics
REACT_APP_GA_TRACKING_ID=

# Mixpanel
REACT_APP_MIXPANEL_TOKEN=

# =============================================================================
# ENVIRONMENT
# =============================================================================
# development, staging, production
REACT_APP_ENVIRONMENT=development

# Enable debug mode (shows extra logging)
REACT_APP_DEBUG=false

# =============================================================================
# PURL CONFIGURATION
# =============================================================================
# Default PURL session timeout (minutes)
REACT_APP_PURL_SESSION_TIMEOUT=30

# Enable PURL debug mode
REACT_APP_PURL_DEBUG=false

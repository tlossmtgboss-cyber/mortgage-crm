# =============================================================================
# VITE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# For production, copy to .env.production
#
# NOTE: Vite uses VITE_ prefix instead of REACT_APP_
# See VITE_MIGRATION.md for details

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL
# Development: http://localhost:8000
# Production: https://your-backend.railway.app
VITE_API_URL=http://localhost:8000

# WebSocket URL for real-time features
# Development: ws://localhost:8000
# Production: wss://your-backend.railway.app
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# MICROSOFT AUTHENTICATION (Required for LO login)
# =============================================================================
# Azure AD App Registration Client ID
# Register at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# =============================================================================
# GOOGLE PLACES API (Required for address autocomplete)
# =============================================================================
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API, Geocoding API
VITE_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =============================================================================
# SOCIAL LOGIN (Optional - for borrower authentication)
# =============================================================================
# Google OAuth
# Configure at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Facebook Login
# Configure at: https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# LinkedIn Login
# Configure at: https://www.linkedin.com/developers/apps
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Apple Sign In
# Configure at: https://developer.apple.com/account/resources/identifiers
VITE_APPLE_CLIENT_ID=your-apple-client-id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features in development
VITE_ENABLE_AGENT_DASHBOARD=true
VITE_ENABLE_AGENT_GYM=true
VITE_ENABLE_PURL_PORTAL=true
VITE_ENABLE_VIDEO_FEATURE=true

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
# Sentry for error tracking
# Get DSN from: https://sentry.io
VITE_SENTRY_DSN=

# Google Analytics
VITE_GA_TRACKING_ID=

# Mixpanel
VITE_MIXPANEL_TOKEN=

# =============================================================================
# ENVIRONMENT
# =============================================================================
# development, staging, production
VITE_ENVIRONMENT=development

# Enable debug mode (shows extra logging)
VITE_DEBUG=false

# =============================================================================
# PURL CONFIGURATION
# =============================================================================
# Default PURL session timeout (minutes)
VITE_PURL_SESSION_TIMEOUT=30

# Enable PURL debug mode
VITE_PURL_DEBUG=false

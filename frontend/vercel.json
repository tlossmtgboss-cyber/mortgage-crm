{
  "rewrites": [
    {
      "source": "/token",
      "destination": "https://api.perenniaai.com/token"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.perenniaai.com/api/:path*"
    },
    {
      "source": "/((?!api|token|static|_next|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=perennia_db
DB_USER=postgres
DB_PASSWORD=your_password

# Microsoft Graph API
GRAPH_ACCESS_TOKEN=your_graph_access_token
SENDER_EMAIL=automation@yourcompany.com
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Email Configuration
INTERNAL_DOMAINS=yourcompany.com,perennia.ai
WEBHOOK_SECRET=your-webhook-secret

# SLA Thresholds (in hours)
SLA_CRITICAL_HOURS=1
SLA_HIGH_HOURS=4
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# Feature Flags
ENABLE_AUTO_RESPONSES=true
ENABLE_LOAN_CREATION=true
ENABLE_INVOICE_PROCESSING=true
ENABLE_SLA_MONITORING=true

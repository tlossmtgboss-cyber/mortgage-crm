  "tools": [
    {
      "name": "send_sms",
      "domain": "communication",
      "description": "Send an SMS text message to a human recipient",
      "endpoint": "/api/tools/communication/send_sms",
      "method": "POST",
      "input_schema": {
        "type": "object",
        "properties": {
          "to_phone": {
            "type": "string",
            "description": "Phone number to send SMS to (E.164 format preferred)"
          },
          "recipient_name": {
            "type": "string",
            "description": "Name of recipient (AI will look up phone number)"
          },
          "message": {
            "type": "string",
            "description": "The SMS message content"
          },
          "context": {
            "type": "object",
            "properties": {
              "crm_contact_id": {"type": "string"},
              "loan_id": {"type": "string"},
              "lead_id": {"type": "string"},
              "category": {
                "type": "string",
                "enum": ["lead_followup", "status_update", "docs_request", "appointment_reminder", "other"]
              }
            }
          }
        },
        "required": ["message"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "data": {
            "type": "object",
            "properties": {
              "sid": {"type": "string"},
              "status": {"type": "string", "enum": ["queued", "sent", "failed"]},
              "to_phone": {"type": "string"}
            }
          },
          "error": {"type": "string", "nullable": true},
          "meta": {
            "type": "object",
            "properties": {
              "tool": {"type": "string"},
              "request_id": {"type": "string"},
              "elapsed_ms": {"type": "number"}
            }
          }
        }
      },
      "side_effect": true,
      "requires_approval": false,
      "risk_level": "high",
      "implemented": true,
      "implementation_location": "main.py:execute_send_sms"
    },

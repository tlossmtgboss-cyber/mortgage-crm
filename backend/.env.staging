# =============================================================================
# STAGING ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy to .env and adjust values for your staging environment

# Environment
ENVIRONMENT=staging

# Database (separate staging database - Railway provides this)
# DATABASE_URL=postgresql://user:pass@staging-db.railway.internal:5432/railway

# Redis (if using Redis - Railway provides this)
# REDIS_URL=redis://staging-redis.railway.internal:6379/0

# Security
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-staging-secret-key-change-this

# JWT Configuration (shorter expiry for testing)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# AI SERVICES
# =============================================================================
AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Deepgram for transcription
DEEPGRAM_API_KEY=your-deepgram-api-key

# =============================================================================
# COMMUNICATIONS
# =============================================================================

# Telnyx Telephony & SMS
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_PHONE_NUMBER=+1234567890
TELNYX_CONNECTION_ID=your-telnyx-connection-id

# Microsoft Graph (for email/calendar)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_REDIRECT_URI=https://staging-api.pipeline360.com/auth/microsoft/callback

# =============================================================================
# STORAGE
# =============================================================================

# AWS S3 (separate staging bucket recommended)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=pipeline360-staging

# =============================================================================
# MONITORING
# =============================================================================

# Sentry (separate staging project recommended)
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project

# Release version
RELEASE_VERSION=staging-latest

# Slow query threshold (ms)
SLOW_QUERY_THRESHOLD_MS=500

# =============================================================================
# RATE LIMITING (more permissive for testing)
# =============================================================================
RATE_LIMIT_PER_MINUTE=200

# =============================================================================
# CORS
# =============================================================================
ALLOWED_ORIGINS=https://staging.pipeline360.com,http://localhost:3000

# =============================================================================
# FRONTEND URL
# =============================================================================
FRONTEND_URL=https://staging.pipeline360.com

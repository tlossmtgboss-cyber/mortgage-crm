# Voice OS Environment Variables Template
# Copy this file to .env and fill in your actual values

# =====================================================
# SERVER CONFIGURATION
# =====================================================
NODE_ENV=development
PORT=8080
DOMAIN=your-domain.com

# =====================================================
# DATABASE
# =====================================================
DATABASE_URL=postgresql://user:password@localhost:5432/pipeline360
REDIS_URL=redis://localhost:6379

# =====================================================
# CRM API INTEGRATION
# =====================================================
CRM_API_URL=https://your-crm-backend.railway.app
CRM_API_KEY=your-crm-api-key-here

# =====================================================
# VOICE SERVICES
# =====================================================

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# =====================================================
# LLM PROVIDERS
# =====================================================

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic (optional, for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key

# =====================================================
# MONITORING & OBSERVABILITY
# =====================================================

# Sentry (optional)
SENTRY_DSN=your-sentry-dsn

# Loki (optional)
LOKI_URL=http://localhost:3100

# Log Level
LOG_LEVEL=info

# =====================================================
# SECURITY
# =====================================================

# Encryption key (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =====================================================
# FEATURE FLAGS
# =====================================================
ENABLE_CALL_RECORDING=true
ENABLE_PII_REDACTION=true
ENABLE_METRICS=true

# =====================================================
# COSTS & QUOTAS
# =====================================================
MAX_CONCURRENT_CALLS=100
MAX_CALL_DURATION_SECONDS=3600

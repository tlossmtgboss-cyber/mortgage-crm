{
  "name": "pipeline360-voice-os",
  "version": "1.0.0",
  "description": "Production-ready AI Voice OS for Pipeline 360 CRM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "@opentelemetry/api": "^1.6.0",
    "@opentelemetry/sdk-node": "^0.43.0",
    "@opentelemetry/instrumentation-http": "^0.43.0",
    "@opentelemetry/instrumentation-express": "^0.34.0",
    "prom-client": "^15.0.0",
    "winston": "^3.11.0",
    "ajv": "^8.12.0",
    "twilio": "^4.19.0",
    "openai": "^4.20.1",
    "@anthropic-ai/sdk": "^0.9.1",
    "@deepgram/sdk": "^3.4.0",
    "elevenlabs": "^0.8.2",
    "axios": "^1.6.0",
    "bull": "^4.11.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/ws": "^8.5.8",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.16",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.7",
    "ts-jest": "^29.1.1",
    "eslint": "^8.53.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"

# ===========================================
# MULTI-TENANT DATABASE CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your actual values

# Master Database (Tenant Registry)
# This database stores the tenant metadata and routing information
MASTER_DATABASE_URL=postgresql://user:password@host:5432/tenants_master

# Database Server Connection (for creating new tenant databases)
# This is the base connection string WITHOUT a specific database name
DATABASE_SERVER_URL=postgresql://user:password@host:5432/postgres

# Optional: Default database URL (for backward compatibility)
DATABASE_URL=postgresql://user:password@host:5432/mortgage_crm

# Tenant Identification Method
# Options: subdomain, header, jwt, or combined
TENANT_IDENTIFICATION_METHOD=subdomain

# Domain for subdomain-based tenant routing
# Example: if TENANT_DOMAIN=yourdomain.com, then
# tenant "acme" will be accessible at acme.yourdomain.com
TENANT_DOMAIN=yourdomain.com

# Custom header name for tenant identification (if using header method)
TENANT_HEADER_NAME=X-Tenant-ID

# JWT claim field for tenant ID (if using JWT method)
TENANT_JWT_CLAIM=tenant_id

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ===========================================
# RAILWAY-SPECIFIC CONFIGURATION
# ===========================================
# If deploying on Railway, use these settings:

# Railway provides DATABASE_URL automatically
# Use it as your MASTER_DATABASE_URL
# MASTER_DATABASE_URL=${{DATABASE_URL}}

# For creating tenant databases on Railway:
# 1. Use the same host/credentials from DATABASE_URL
# 2. Extract host, user, password, port from DATABASE_URL
# DATABASE_SERVER_URL=postgresql://${{PGUSER}}:${{PGPASSWORD}}@${{PGHOST}}:${{PGPORT}}/postgres

# ===========================================
# EXAMPLE CONFIGURATIONS
# ===========================================

# Local Development:
# MASTER_DATABASE_URL=postgresql://localhost:5432/mortgage_crm_master
# DATABASE_SERVER_URL=postgresql://localhost:5432/postgres
# TENANT_DOMAIN=localhost:3000

# Railway Production:
# MASTER_DATABASE_URL=${{DATABASE_URL}}
# DATABASE_SERVER_URL=postgresql://${{PGUSER}}:${{PGPASSWORD}}@${{PGHOST}}:${{PGPORT}}/postgres
# TENANT_DOMAIN=perenniaai.com

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit .env file to version control
# 2. Use strong passwords for database users
# 3. Limit database user permissions appropriately
# 4. Use SSL connections in production (add ?sslmode=require to connection strings)
# 5. Rotate database credentials regularly

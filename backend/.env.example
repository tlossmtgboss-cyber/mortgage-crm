# Database Configuration
# For PostgreSQL (recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentic_crm

# For SQLite (development only)
# DATABASE_URL=sqlite:///./agentic_crm.db

# Security
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider Selection
# Choose 'claude' for Claude 4 Sonnet (recommended) or 'openai' for legacy OpenAI
AI_PROVIDER=claude

# OpenAI API (Required if AI_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API (Required if AI_PROVIDER=claude)
# Get your API key from: https://console.anthropic.com/
# Claude 4 Sonnet provides superior email parsing with all 156 CRM fields
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Microsoft Graph API (Required for Teams, Email, Calendar)
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_FROM_EMAIL=your-email@company.com

# Webhook URLs (for receiving incoming messages)
WEBHOOK_BASE_URL=https://your-domain.com  # Or ngrok URL for development

# Environment
# Options: development, staging, production
ENVIRONMENT=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO

# =============================================================================
# REDIS CACHE (Optional but recommended for performance)
# =============================================================================
# Redis URL for AI response caching
# Provides 2-10x speedup for repeat queries
# Get from Railway, Upstash, or local Redis
REDIS_URL=redis://localhost:6379

# Webhook secret for cache invalidation from external systems
WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# MICROSOFT GRAPH EMAIL WEBHOOKS (Optional - for real-time email processing)
# =============================================================================
# Public URL where Graph will send email notifications
# Must be HTTPS and publicly accessible
GRAPH_WEBHOOK_URL=https://your-app.railway.app/api/webhooks/graph

# Secret for webhook validation (falls back to WEBHOOK_SECRET if not set)
GRAPH_WEBHOOK_SECRET=your-graph-webhook-secret

# =============================================================================
# PRODUCTION MONITORING (Required for production)
# =============================================================================

# Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/projects/[project]/keys/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Release version for Sentry (set during deployment)
RELEASE_VERSION=1.0.0

# Slow Query Threshold (milliseconds)
SLOW_QUERY_THRESHOLD_MS=500

# =============================================================================
# AWS S3 (Required for video storage)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-video-bucket

# =============================================================================
# SENDGRID EMAIL (Required for borrower notifications)
# =============================================================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company Mortgage

# =============================================================================
# BORROWER OAUTH PROVIDERS (For borrower social login)
# =============================================================================

# Google OAuth (for borrower login)
# Configure at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (for borrower login)
# Configure at: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# LinkedIn OAuth (for borrower login)
# Configure at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Apple Sign In (for borrower login)
# Configure at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=your-apple-service-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8

# =============================================================================
# GOOGLE PLACES API (Required for address/employer autocomplete)
# =============================================================================
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API, Geocoding API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =============================================================================
# CALENDLY INTEGRATION (For calendar scheduling)
# =============================================================================
# Register app at: https://developer.calendly.com/
# Create OAuth application and get credentials

# Calendly OAuth credentials
CALENDLY_CLIENT_ID=your-calendly-client-id
CALENDLY_CLIENT_SECRET=your-calendly-client-secret
CALENDLY_REDIRECT_URI=http://localhost:3000/oauth/callback

# Encryption key for storing OAuth tokens securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDLY_ENCRYPTION_KEY=your-encryption-key-here

# Webhook secret for verifying incoming Calendly webhooks (optional)
CALENDLY_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Claude model for AI features (concierge, social content, etc.)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# FRONTEND URL (Required for email links)
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# PURL SYSTEM (Personalized URL Portal)
# =============================================================================
# Token expiration in days (default 30)
PURL_TOKEN_EXPIRY_DAYS=30

# Base URL for PURL portal links
PURL_BASE_URL=http://localhost:3000/portal

# Base domain for portal redirect URLs (used after application submission)
# Development: localhost:3000
# Production: perenniaai.com or your custom domain
PURL_BASE_DOMAIN=perenniaai.com

# Rate limiting
PURL_RATE_LIMIT_PER_MINUTE=60

# Session timeout in minutes
PURL_SESSION_TIMEOUT_MINUTES=30

# Email notifications
PURL_EMAIL_ENABLED=true
PURL_EMAIL_FROM=noreply@yourcompany.com

# Security settings
PURL_REQUIRE_EMAIL_VERIFICATION=false
PURL_MAX_FAILED_ATTEMPTS=5
PURL_LOCKOUT_DURATION_MINUTES=15

# Debug mode (set to false in production)
PURL_DEBUG=false

# =============================================================================
# AGENT GOVERNANCE SYSTEM
# =============================================================================
# Enable/disable agent governance
AGENT_GOVERNANCE_ENABLED=true

# Default approval settings
AGENT_AUTO_APPROVE_LOW_RISK=true
AGENT_REQUIRE_HUMAN_APPROVAL_HIGH_RISK=true

# Agent execution limits
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TASK_TIMEOUT_SECONDS=300

# =============================================================================
# AGENT GYM (Training & Testing)
# =============================================================================
# Enable agent gym features
AGENT_GYM_ENABLED=true

# Sandbox mode for testing
AGENT_GYM_SANDBOX_MODE=true

# =============================================================================
# CELERY / BACKGROUND TASKS (Optional)
# =============================================================================
# Celery broker URL (Redis recommended)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# WebSocket ping interval in seconds
WS_PING_INTERVAL=30

# WebSocket timeout in seconds
WS_TIMEOUT=60

# =============================================================================
# GOOGLE CLOUD TEXT-TO-SPEECH (For AI voice synthesis)
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a Service Account with "Cloud Text-to-Speech User" role
# 2. Download the JSON key file
# 3. Set the path to your JSON key file below

# Path to Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Enable Google TTS (set to true to use instead of ElevenLabs)
GOOGLE_TTS_ENABLED=false

# Default Google TTS voice (Neural2 voices recommended for quality)
# See all voices: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE=en-US

# =============================================================================
# RETELL AI (Conversational Voice AI Platform)
# =============================================================================
# Get API key from: https://beta.retellai.com/
# Retell AI provides conversational AI voice agents for phone calls
#
# Note: This is an OPTIONAL global fallback. Users can add their own
# Retell API keys through the CRM's Integration Settings UI.
#
# If set, this will be used when user hasn't configured their own key

# Retell AI API Key (optional - users can configure their own)
RETELL_API_KEY=your-retell-api-key

# Webhook URL for Retell AI call events
# Configure this URL in your Retell AI dashboard for each agent
RETELL_WEBHOOK_URL=https://app.perenniaai.com/api/v1/retell/webhooks/call-events

# =============================================================================
# VIDYARD AI AVATARS (For AI video generation)
# =============================================================================
# Get API token from: https://knowledge.vidyard.com/hc/en-us/articles/360010000133
# AI Avatar features require Video Agent add-on or Enterprise plan

# Vidyard Dashboard API token
VIDYARD_API_TOKEN=your-vidyard-api-token

# Vidyard AI Avatar API token (if different from dashboard token)
# Contact Vidyard for AI Avatar API access
VIDYARD_AI_AVATAR_TOKEN=your-vidyard-ai-avatar-token

# Webhook URL for async video generation callbacks
# Vidyard will POST to this URL when avatar training or video generation completes
VIDYARD_WEBHOOK_URL=https://app.perenniaai.com/api/v1/vidyard/webhooks

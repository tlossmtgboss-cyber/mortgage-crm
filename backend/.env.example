# Database Configuration
# For PostgreSQL (recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentic_crm

# For SQLite (development only)
# DATABASE_URL=sqlite:///./agentic_crm.db

# Security
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider Selection
# Choose 'claude' for Claude 4 Sonnet (recommended) or 'openai' for legacy OpenAI
AI_PROVIDER=claude

# OpenAI API (Required if AI_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API (Required if AI_PROVIDER=claude)
# Get your API key from: https://console.anthropic.com/
# Claude 4 Sonnet provides superior email parsing with all 156 CRM fields
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Microsoft Graph API (Required for Teams, Email, Calendar)
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_FROM_EMAIL=your-email@company.com

# Webhook URLs (for receiving incoming messages)
WEBHOOK_BASE_URL=https://your-domain.com  # Or ngrok URL for development

# Environment
# Options: development, staging, production
ENVIRONMENT=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO

# =============================================================================
# REDIS CACHE (Optional but recommended for performance)
# =============================================================================
# Redis URL for AI response caching
# Provides 2-10x speedup for repeat queries
# Get from Railway, Upstash, or local Redis
REDIS_URL=redis://localhost:6379

# Webhook secret for cache invalidation from external systems
WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# MICROSOFT GRAPH EMAIL WEBHOOKS (Optional - for real-time email processing)
# =============================================================================
# Public URL where Graph will send email notifications
# Must be HTTPS and publicly accessible
GRAPH_WEBHOOK_URL=https://your-app.railway.app/api/webhooks/graph

# Secret for webhook validation (falls back to WEBHOOK_SECRET if not set)
GRAPH_WEBHOOK_SECRET=your-graph-webhook-secret

# =============================================================================
# PRODUCTION MONITORING (Required for production)
# =============================================================================

# Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/projects/[project]/keys/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Release version for Sentry (set during deployment)
RELEASE_VERSION=1.0.0

# Slow Query Threshold (milliseconds)
SLOW_QUERY_THRESHOLD_MS=500

# =============================================================================
# AWS S3 (Required for video storage)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-video-bucket

# =============================================================================
# SENDGRID EMAIL (Required for borrower notifications)
# =============================================================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company Mortgage

# =============================================================================
# BORROWER OAUTH PROVIDERS (For borrower social login)
# =============================================================================

# Google OAuth (for borrower login)
# Configure at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (for borrower login)
# Configure at: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# LinkedIn OAuth (for borrower login)
# Configure at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Apple Sign In (for borrower login)
# Configure at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=your-apple-service-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8

# =============================================================================
# GOOGLE PLACES API (Required for address/employer autocomplete)
# =============================================================================
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API, Geocoding API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =============================================================================
# TELNYX SMS & TELEPHONY (Required for SMS messaging and voice calls)
# =============================================================================
# Sign up at: https://telnyx.com/sign-up
# Get API key from: https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=your_telnyx_api_key_here

# Phone number for outbound SMS and voice calls
# Format: +1234567890 (E.164 format with country code)
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX

# Messaging profile ID from Telnyx portal
# Found in: https://portal.telnyx.com/#/app/messaging
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id

# Connection ID for voice calls
TELNYX_CONNECTION_ID=your-connection-id

# Webhook signature secret for validating incoming webhooks
# Generate in: https://portal.telnyx.com/#/app/webhooks
TELNYX_WEBHOOK_SECRET=your-webhook-secret

# Enable 2FA SMS for user authentication (true/false)
ENABLE_2FA_SMS=false

# Public key for webhook verification (Required in production for webhook verification)
TELNYX_PUBLIC_KEY=your-telnyx-public-key

# =============================================================================
# CALENDLY INTEGRATION (For calendar scheduling)
# =============================================================================
# Register app at: https://developer.calendly.com/
# Create OAuth application and get credentials

# Calendly OAuth credentials
CALENDLY_CLIENT_ID=your-calendly-client-id
CALENDLY_CLIENT_SECRET=your-calendly-client-secret
CALENDLY_REDIRECT_URI=http://localhost:3000/oauth/callback

# Encryption key for storing OAuth tokens securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDLY_ENCRYPTION_KEY=your-encryption-key-here

# Webhook secret for verifying incoming Calendly webhooks (optional)
CALENDLY_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Claude model for AI features (concierge, social content, etc.)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# CALL INTELLIGENCE (Transcription, voice AI, and call analysis)
# =============================================================================
# LiveKit — Real-time voice agent (WebRTC)
# Get credentials from: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cartesia — TTS for Aria voice agent
# Get your API key from: https://play.cartesia.ai/
CARTESIA_API_KEY=
ARIA_CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# Aria voice LLM model (default: claude-sonnet-4-20250514)
ARIA_LLM_MODEL=claude-sonnet-4-20250514

# Deepgram API key — required for real-time and batch call transcription
# Get your API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Vapi API key — required for AI-powered voice calls (Twilio-backed)
# Get your API key from: https://dashboard.vapi.ai/
VAPI_API_KEY=

# Vapi webhook secret for verifying incoming Vapi webhooks
# Required in production for Vapi webhook verification
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# LLM provider for call intelligence analysis
# Options: anthropic, openai, mistral
CI_LLM_PROVIDER=anthropic

# Extraction strategy feature flag
# true = single-pass unified extractor, false = parallel specialist agents
USE_UNIFIED_EXTRACTOR=false

# =============================================================================
# FRONTEND URL (Required for email links)
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# PURL SYSTEM (Personalized URL Portal)
# =============================================================================
# Token expiration in days (default 30)
PURL_TOKEN_EXPIRY_DAYS=30

# Base URL for PURL portal links
PURL_BASE_URL=http://localhost:3000/portal

# Base domain for portal redirect URLs (used after application submission)
# Development: localhost:3000
# Production: perenniaai.com or your custom domain
PURL_BASE_DOMAIN=perenniaai.com

# Rate limiting — PURL portal
PURL_RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# API RATE LIMITING (Per-User / Per-IP Sliding Window)
# =============================================================================
# Global enable/disable for the API rate limit middleware
API_RL_ENABLED=true
# Default requests per minute for authenticated users
API_RL_AUTH_RPM=60
# Default requests per minute for unauthenticated (IP-based) requests
API_RL_UNAUTH_RPM=20
# AI endpoints (/api/v1/ai/, /api/v1/chat/, /api/v1/agents/) — lower because expensive
API_RL_AI_RPM=30
# Security/audit endpoints (/api/v1/security/, /api/v1/audit/) — higher for batch audit logs
API_RL_SECURITY_RPM=100
# Pipeline/dashboard endpoints (/api/v1/pipeline/, /api/v1/dashboard/) — higher for polling
API_RL_PIPELINE_RPM=120
# Max tracked keys before oldest are evicted (memory safety)
API_RL_MAX_KEYS=50000
# Redis key prefix for distributed rate limiting
API_RL_REDIS_PREFIX=apirl:

# Session timeout in minutes
PURL_SESSION_TIMEOUT_MINUTES=30

# Email notifications
PURL_EMAIL_ENABLED=true
PURL_EMAIL_FROM=noreply@yourcompany.com

# Security settings
PURL_REQUIRE_EMAIL_VERIFICATION=false
PURL_MAX_FAILED_ATTEMPTS=5
PURL_LOCKOUT_DURATION_MINUTES=15

# Debug mode (set to false in production)
PURL_DEBUG=false

# =============================================================================
# AGENT GOVERNANCE SYSTEM
# =============================================================================
# Enable/disable agent governance
AGENT_GOVERNANCE_ENABLED=true

# Default approval settings
AGENT_AUTO_APPROVE_LOW_RISK=true
AGENT_REQUIRE_HUMAN_APPROVAL_HIGH_RISK=true

# Agent execution limits
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TASK_TIMEOUT_SECONDS=300

# =============================================================================
# AGENT GYM (Training & Testing)
# =============================================================================
# Enable agent gym features
AGENT_GYM_ENABLED=true

# Sandbox mode for testing
AGENT_GYM_SANDBOX_MODE=true

# =============================================================================
# CELERY / BACKGROUND TASKS (Optional)
# =============================================================================
# Celery broker URL (Redis recommended)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# WebSocket ping interval in seconds
WS_PING_INTERVAL=30

# WebSocket timeout in seconds
WS_TIMEOUT=60

# =============================================================================
# GOOGLE CLOUD TEXT-TO-SPEECH (For AI voice synthesis)
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a Service Account with "Cloud Text-to-Speech User" role
# 2. Download the JSON key file
# 3. Set the path to your JSON key file below

# Path to Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Enable Google TTS (set to true to use instead of ElevenLabs)
GOOGLE_TTS_ENABLED=false

# Default Google TTS voice (Neural2 voices recommended for quality)
# See all voices: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE=en-US

# =============================================================================
# RETELL AI (Conversational Voice AI Platform)
# =============================================================================
# Get API key from: https://beta.retellai.com/
# Retell AI provides conversational AI voice agents for phone calls
#
# Note: This is an OPTIONAL global fallback. Users can add their own
# Retell API keys through the CRM's Integration Settings UI.
#
# If set, this will be used when user hasn't configured their own key

# Retell AI API Key (optional - users can configure their own)
RETELL_API_KEY=your-retell-api-key

# Webhook URL for Retell AI call events
# Configure this URL in your Retell AI dashboard for each agent
RETELL_WEBHOOK_URL=https://app.perenniaai.com/api/v1/retell/webhooks/call-events

# =============================================================================
# VIDYARD AI AVATARS (For AI video generation)
# =============================================================================
# Get API token from: https://knowledge.vidyard.com/hc/en-us/articles/360010000133
# AI Avatar features require Video Agent add-on or Enterprise plan

# Vidyard Dashboard API token
VIDYARD_API_TOKEN=your-vidyard-api-token

# Vidyard AI Avatar API token (if different from dashboard token)
# Contact Vidyard for AI Avatar API access
VIDYARD_AI_AVATAR_TOKEN=your-vidyard-ai-avatar-token

# Webhook URL for async video generation callbacks
# Vidyard will POST to this URL when avatar training or video generation completes
VIDYARD_WEBHOOK_URL=https://app.perenniaai.com/api/v1/vidyard/webhooks

# =============================================================================
# E-SIGNATURE CRYPTO (Required for e-sign functionality)
# =============================================================================
# Master secret for HMAC-based signatures (minimum 32 characters)
# Generate with: openssl rand -hex 32
# This key is used for document integrity verification and signature generation
ESIGN_SIGNING_SECRET=your-signing-secret-here

# Token generation secret for signing session tokens (minimum 32 characters)
# Generate with: openssl rand -hex 32
# Used for time-limited cryptographically signed access tokens
ESIGN_TOKEN_SECRET=your-token-secret-here

# =============================================================================
# MOBILE APP VERSION GATE
# =============================================================================
# Controls forced updates, optional update banners, and maintenance mode
# for the native iOS/Android app. Bump minimum_version to force users
# off broken builds. Set maintenance mode to block all access during deploys.

# iOS
IOS_MIN_VERSION=1.0.0
IOS_RECOMMENDED_VERSION=1.0.2
IOS_CURRENT_VERSION=1.0.2
IOS_STORE_URL=https://apps.apple.com/app/perenniaai-crm-platform/id6743197498
# IOS_CHANGELOG=Bug fixes and performance improvements.

# Android (placeholder until Play Store listing exists)
ANDROID_MIN_VERSION=1.0.0
ANDROID_RECOMMENDED_VERSION=1.0.0
ANDROID_CURRENT_VERSION=1.0.0
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.perenniaai.crm

# Maintenance mode — set to true during planned outages
APP_MAINTENANCE_MODE=false
# APP_MAINTENANCE_MESSAGE=We're performing scheduled maintenance. Please try again shortly.

# =============================================================================
# APPLE PUSH NOTIFICATION SERVICE (APNs) — iOS Push Notifications
# =============================================================================
# Required for sending push notifications to iOS devices.
# 1. Create an APNs Auth Key in Apple Developer portal:
#    https://developer.apple.com/account/resources/authkeys/list
# 2. Download the .p8 file and note the Key ID
# 3. Your Team ID is in the top-right of the Apple Developer portal

# APNs Auth Key ID (10-character string from Apple Developer portal)
APNS_KEY_ID=

# Apple Developer Team ID (10-character string)
APNS_TEAM_ID=

# Path to the .p8 private key file downloaded from Apple
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# App bundle identifier (must match the iOS app's bundle ID)
APNS_BUNDLE_ID=com.perenniaai.crm

# Use APNs sandbox (true for development/TestFlight, false for production App Store builds)
APNS_USE_SANDBOX=true

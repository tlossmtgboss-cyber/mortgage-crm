# =============================================================================
# Perennia AI Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines marked [REQUIRED] must be set for the app to start.
# Lines marked [PRODUCTION] are only needed in production/staging.

# =============================================================================
# Core Configuration
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# [REQUIRED] Signing key for HS256 JWTs and misc HMAC operations.
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# [REQUIRED] PostgreSQL connection string. SQLite works for local dev only.
DATABASE_URL=postgresql://postgres:password@localhost:5432/perennia
# DATABASE_URL=sqlite:///./mortgage_crm.db

# Railway sets this; used for PgBouncer-style pooled connections.
# If identical to DATABASE_URL, connection pooling is used automatically.
# DATABASE_POOLED_URL=

# Port the server listens on (Railway injects this automatically)
PORT=8000

# =============================================================================
# Authentication (RS256 — recommended for production)
# =============================================================================
# Set to True to use RS256 asymmetric JWTs instead of HS256.
# _USE_SECURE_TOKENS=True

# RSA keys — provide as base64-encoded PEM or raw PEM strings.
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then base64: cat private.pem | base64 -w0
# AUTH_PRIVATE_KEY=
# AUTH_PUBLIC_KEY=

# Alternatively, provide file paths to PEM files:
# AUTH_PRIVATE_KEY_PATH=/path/to/private.pem
# AUTH_PUBLIC_KEY_PATH=/path/to/public.pem

# JWT algorithm override (defaults based on key availability)
# AUTH_ALGORITHM=RS256

# Access token expiry in minutes (default 15)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Redis (token blacklist, rate limiting, caching, Celery broker)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI / LLM Providers
# =============================================================================
# [REQUIRED] Anthropic API key — primary AI provider for agents, chat, doc analysis
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model for AI features (agents, concierge, social content, doc analysis)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI API key — used by AI receptionist, legacy AI services
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# OpenAI model for receptionist
# OPENAI_MODEL=gpt-4o-mini

# AI provider selection for certain services
AI_PROVIDER=claude

# Call Intelligence LLM provider: anthropic, openai, or mistral
CI_LLM_PROVIDER=anthropic
# CI_LLM_MODEL=claude-sonnet-4-20250514
# CI_LLM_TEMPERATURE=0.1
# CI_LLM_MAX_TOKENS=4096
# CI_LLM_TIMEOUT=60

# Mistral API key (only if CI_LLM_PROVIDER=mistral)
# MISTRAL_API_KEY=

# AI token budget controls (per org)
# AI_MAX_TOKENS_PER_ORG_HOUR=500000
# AI_BUDGET_PERIOD_SECONDS=3600
# AI_REQUESTS_PER_MINUTE=30
# AI_MAX_BURST=10

# =============================================================================
# Telephony — Telnyx (SMS, click-to-call, direct voice)
# =============================================================================
# Sign up at: https://telnyx.com/sign-up
# Get API key from: https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=KEY...

# E.164 format phone number for outbound SMS and voice
TELNYX_PHONE_NUMBER=+18438838956

# From number override (defaults to TELNYX_PHONE_NUMBER)
# TELNYX_FROM_NUMBER=+18438838956

# Messaging profile ID from Telnyx portal
TELNYX_MESSAGING_PROFILE_ID=40019bed-2fa1-4407-a0c6-fe4c6b222c93

# Connection ID for voice calls (TeXML app or SIP)
# TELNYX_CONNECTION_ID=

# Public key for webhook signature verification
# TELNYX_PUBLIC_KEY=

# Webhook secret for Telnyx event validation
# TELNYX_WEBHOOK_SECRET=

# =============================================================================
# Telephony — Vapi (AI outbound calls, voicemail drops)
# =============================================================================
# Get API key from: https://vapi.ai/
VAPI_API_KEY=

# Vapi assistant IDs
VAPI_ASSISTANT_ID=120e239e-4d19-4e43-ad92-1f8b07d08c8c
# VAPI_REFINANCE_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=

# =============================================================================
# Telephony — Twilio (Vapi-backed numbers)
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# =============================================================================
# Telephony — Slybroadcast (Ringless Voicemail)
# =============================================================================
# SLYBROADCAST_EMAIL=
# SLYBROADCAST_PASSWORD=
# SLYBROADCAST_CALLER_ID=8438345251

# =============================================================================
# Telephony — Retell AI (Conversational Voice AI — optional)
# =============================================================================
# Users can configure their own via Integration Settings UI.
# This is a global fallback.
# RETELL_API_KEY=

# =============================================================================
# Voice Configuration
# =============================================================================
# TELEPHONY_PROVIDER=telnyx
# VOICE_ASSISTANT_NAME=Aria
# AI_RECEPTIONIST_NAME=Sam
# BUSINESS_NAME=CMG Home Loans
# LO_NAME=Tim
# DEFAULT_LO_NAME=Tim
# ENABLE_POST_CALL_SMS=true

# =============================================================================
# Email — Microsoft Graph (send from LO's Outlook)
# =============================================================================
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# MICROSOFT_FROM_EMAIL=your-email@company.com

# Graph webhook for real-time email notifications
# GRAPH_WEBHOOK_URL=https://api.perenniaai.com/api/webhooks/graph
# GRAPH_WEBHOOK_SECRET=

# =============================================================================
# Email — SMTP Fallback (for digest emails, briefings)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=briefing@perenniaai.com

# =============================================================================
# Email — SendGrid (borrower notifications, morning briefings)
# =============================================================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=
# SENDGRID_FROM_NAME=Perennia AI
# BRIEFING_FROM_EMAIL=briefing@perenniaai.com

# Outbound AI email address fallback
# AI_FROM_EMAIL=

# =============================================================================
# Storage — AWS S3
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Primary document bucket
PERENNIA_S3_BUCKET=perennia-docs
S3_BUCKET_NAME=perennia-docs

# Additional buckets (default to primary if not set)
# VIDEO_S3_BUCKET=perennia-videos
# SMART_DOCS_S3_BUCKET=perennia-smart-docs
# AVATAR_ASSETS_BUCKET=perennia-avatars
# CHIME_RECORDING_S3_BUCKET=perennia-recordings
# TEXTRACT_S3_BUCKET=

# Disaster recovery (optional)
# DR_AWS_REGION=us-west-2
# DR_S3_BUCKET=perennia-docs-dr
# DB_BACKUP_S3_BUCKET=perennia-docs
# DB_BACKUP_S3_PREFIX=database-backups/

# =============================================================================
# Payments — Stripe
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=price_starter
# STRIPE_PRO_PRICE_ID=price_professional
# STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

# =============================================================================
# Push Notifications — APNs (iOS)
# =============================================================================
APNS_KEY_ID=
APNS_TEAM_ID=V5ZA5FZ2J8
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.perenniaai.crm
APNS_USE_SANDBOX=true

# =============================================================================
# Encryption
# =============================================================================
# [REQUIRED in production] Fernet key for field-level encryption (PII, tokens, secrets)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# PII encryption key for Smart Docs
# PII_ENCRYPTION_KEY=

# SMS credential encryption
# SMS_ENCRYPTION_KEY=

# =============================================================================
# Webhook Secrets (signature verification for inbound webhooks)
# =============================================================================
RETR_WEBHOOK_SECRET=
INBOUND_WEBHOOK_SECRET=
ENCOMPASS_WEBHOOK_SECRET=
CRM_WEBHOOK_SECRET=
# WEBHOOK_SECRET=
# WEBHOOK_HMAC_SECRET=
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=
# CALENDLY_WEBHOOK_SECRET=
# SALESFORCE_WEBHOOK_SECRET=
# SALESFORCE_CDC_WEBHOOK_SECRET=

# =============================================================================
# Deepgram (speech-to-text transcription)
# =============================================================================
DEEPGRAM_API_KEY=

# =============================================================================

# Database Configuration
# For PostgreSQL (recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentic_crm

# For SQLite (development only)
# DATABASE_URL=sqlite:///./agentic_crm.db

# Security
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider Selection
# Choose 'claude' for Claude 4 Sonnet (recommended) or 'openai' for legacy OpenAI
AI_PROVIDER=claude

# OpenAI API (Required if AI_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API (Required if AI_PROVIDER=claude)
# Get your API key from: https://console.anthropic.com/
# Claude 4 Sonnet provides superior email parsing with all 156 CRM fields
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Microsoft Graph API (Required for Teams, Email, Calendar)
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_FROM_EMAIL=your-email@company.com

# Twilio SMS (Required for text messaging)
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
# Use EITHER Auth Token OR API Key (API Key is more secure)
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# OR use API Key credentials (recommended)
TWILIO_API_KEY_SID=your-api-key-sid
TWILIO_API_KEY_SECRET=your-api-key-secret
TWILIO_PHONE_NUMBER=+1234567890

# Webhook URLs (for receiving incoming messages)
WEBHOOK_BASE_URL=https://your-domain.com  # Or ngrok URL for development

# Environment
# Options: development, staging, production
ENVIRONMENT=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO

# =============================================================================
# PRODUCTION MONITORING (Required for production)
# =============================================================================

# Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/projects/[project]/keys/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Release version for Sentry (set during deployment)
RELEASE_VERSION=1.0.0

# Slow Query Threshold (milliseconds)
SLOW_QUERY_THRESHOLD_MS=500

# =============================================================================
# AWS S3 (Required for video storage)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-video-bucket
